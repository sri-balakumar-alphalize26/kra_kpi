# Our meeting room (Jitsi) settings.
# setup-meeting.ps1 copies this to .env and fills in every secret. .env is
# never committed. Change a value here or in .env, then run start-meeting.cmd.

# The official Jitsi release we run. To update Jitsi, change this and run
# setup-meeting.ps1 again.
JITSI_IMAGE_VERSION=stable-11248-1

# Where Jitsi keeps its own settings and data (created by setup).
CONFIG=./data

# The address clients see. Cloudflare gives it HTTPS and forwards it to
# HTTP_PORT on this PC.
PUBLIC_URL=https://meet.alphalize.com
HTTP_PORT=8000
HTTPS_PORT=8443
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
TZ=Asia/Kolkata
RESTART_POLICY=unless-stopped

# Sound and video. The router forwards UDP 10000 to this PC.
JVB_PORT=10000
# This PC's office address and its public address. Change the second one if
# the internet provider gives us a new public IP.
JVB_ADVERTISE_IPS=192.168.1.211,116.68.89.115

# Passes: only people Odoo hands a pass to can join. Copy JWT_APP_ID and
# JWT_APP_SECRET into Odoo > Settings > AI & Transcription > Meeting Server.
ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=alphalize_meet
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=alphalize_meet
JWT_ACCEPTED_AUDIENCES=jitsi
ENABLE_GUESTS=0

# What the call looks like. More in ../branding/.
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0
ENABLE_PREJOIN_PAGE=0
ENABLE_LOBBY=0

# Internal passwords between Jitsi's own parts. Filled in by setup.
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
