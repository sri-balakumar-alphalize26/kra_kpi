# Copy to .env.local (not committed) and restart `npm run dev` after changing it.
# Server-side only: the browser never sees the Odoo address or database.

# The Odoo 19 that has kra_kpi_module installed.
ODOO_URL=http://localhost:8069
# Database on that Odoo. Sent as the X-Odoo-Database header on every call, so one
# Odoo holding several databases works without --db-filter. Leave empty on a
# single-database Odoo.
ODOO_DB=

# Optional: hide the admin area behind a secret word (369Mart pattern). Not used yet.
# ADMIN_PATH=

# Default look. One of: krakpi | jira | family369 | dark | dense. Users can switch
# from their avatar menu; the choice is remembered per browser.
NEXT_PUBLIC_DEFAULT_THEME=krakpi
NEXT_PUBLIC_APP_NAME=KRA KPI
