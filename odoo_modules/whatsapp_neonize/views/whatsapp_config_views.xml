<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ WHATSAPP CONFIG FORM ============ -->
    <record id="view_whatsapp_config_form" model="ir.ui.view">
        <field name="name">whatsapp.config.form</field>
        <field name="model">whatsapp.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                    </group>

                    <separator string="📧 Default Email Session"/>
                    <div class="alert alert-info" role="alert" style="margin: 8px 0;">
                        Auto-send (sale confirm, PO confirm, vendor bills, POS, credit approvals)
                        uses the <strong>default email session</strong> selected below. Add or
                        manage email accounts under
                        <strong>WhatsApp and Email → Email Sessions</strong>.
                    </div>
                    <group>
                        <group>
                            <field name="default_email_session_id"
                                   options="{'no_create': True}"
                                   placeholder="Select connected email account"/>
                        </group>
                        <group>
                            <field name="default_whatsapp_session_id"
                                   options="{'no_create': True}"
                                   placeholder="Select connected WhatsApp session"/>
                        </group>
                    </group>

                    <separator string="📱 Owner Notification Numbers (WhatsApp)"/>
                    <p class="text-muted">
                        Add phone numbers (with country code, no + sign) to receive
                        business notifications via WhatsApp.
                    </p>
                    <field name="owner_number_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="e.g. Owner / Manager"/>
                            <field name="phone" placeholder="e.g. 919944080209"/>
                            <field name="active"/>
                        </list>
                    </field>

                    <notebook>
                        <page string="Sales Auto-Send" name="sales_auto">
                            <group>
                                <group string="On Quotation Send (state = Sent)">
                                    <field name="auto_send_so_quotation_wa"/>
                                    <field name="auto_send_so_quotation_email" invisible="1"/>
                                </group>
                                <group string="On Order Confirmation">
                                    <field name="auto_send_so_confirm_email"/>
                                    <field name="auto_send_so_confirm_wa"/>
                                </group>
                            </group>
                            <p class="text-muted" style="padding: 10px;">
                                <strong>Quotation send:</strong> when you click Odoo's
                                <em>Send by Email</em> button (which sets state=Sent), the email
                                is delivered by Odoo's standard flow. Toggle <em>Auto WhatsApp
                                Quotation</em> ON to also fire WhatsApp at the same time.<br/>
                                <strong>Order confirmation:</strong> when you click Confirm,
                                both WhatsApp and Email fire (according to the toggles).
                                A manual <em>Send WhatsApp &amp; Email</em> button is also
                                available on the sale order form for ad-hoc sends at any state.
                            </p>
                        </page>

                        <page string="Purchase &amp; Invoicing Auto-Send" name="purchase_auto">
                            <group>
                                <group string="On PO Confirmation">
                                    <field name="auto_send_po_confirm_email"/>
                                    <field name="auto_send_po_confirm_wa"/>
                                </group>
                                <group string="Vendor Bill Posted">
                                    <field name="auto_send_bill_email"/>
                                    <field name="auto_send_bill_wa"/>
                                </group>
                                <group string="Customer Invoice Posted">
                                    <field name="auto_send_invoice_email"/>
                                    <field name="auto_send_invoice_wa"/>
                                </group>
                                <group string="Payment Posted (Receipt / Remittance)">
                                    <field name="auto_send_payment_receipt_email"/>
                                    <field name="auto_send_payment_receipt_wa"/>
                                </group>
                            </group>
                            <p class="text-muted" style="padding: 10px;">
                                <strong>PO Confirm:</strong> sends the purchase order PDF to the vendor.<br/>
                                <strong>Vendor Bill Posted:</strong> sends the bill PDF to the vendor.<br/>
                                <strong>Customer Invoice Posted:</strong> sends the invoice PDF to the customer.<br/>
                                Manual <em>Send WhatsApp &amp; Email</em> buttons are also available
                                on each document form.
                            </p>
                        </page>

                        <page string="POS Notifications" name="pos_auto">
                            <p class="text-muted" style="padding: 8px 0;">
                                POS notifications use the <strong>Default WhatsApp Session</strong>
                                and <strong>Default Email Session</strong> selected at the top of
                                this page.
                            </p>
                            <group>
                                <group string="WhatsApp">
                                    <field name="pos_notify_enabled"/>
                                    <field name="pos_notify_owners"
                                           invisible="not pos_notify_enabled"/>
                                    <field name="pos_notify_customer"
                                           invisible="not pos_notify_enabled"/>
                                    <field name="pos_session_id" invisible="1"/>
                                </group>
                                <group string="Email (mirrors WhatsApp)">
                                    <field name="pos_email_notify_enabled"/>
                                    <field name="pos_email_notify_owners"
                                           invisible="not pos_email_notify_enabled"/>
                                    <field name="pos_email_notify_customer"
                                           invisible="not pos_email_notify_enabled"/>
                                    <field name="pos_owner_emails"
                                           invisible="not pos_email_notify_enabled or not pos_email_notify_owners"
                                           placeholder="manager@co.com, owner@co.com"/>
                                </group>
                            </group>
                            <group invisible="not pos_notify_enabled and not pos_email_notify_enabled"
                                   string="Message Template (used for both channels)">
                                <field name="pos_message_template" nolabel="1"
                                       placeholder="Message template for POS orders..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ WHATSAPP CONFIG ACTION ============ -->
    <!-- Server action to get/create config and open it -->
    <record id="action_whatsapp_config_server" model="ir.actions.server">
        <field name="name">WhatsApp and Email Settings</field>
        <field name="model_id" ref="model_whatsapp_config"/>
        <field name="state">code</field>
        <field name="code">
config = env['whatsapp.config'].sudo().get_config()
action = {
    'type': 'ir.actions.act_window',
    'name': 'WhatsApp and Email Settings',
    'res_model': 'whatsapp.config',
    'view_mode': 'form',
    'res_id': config.id,
    'target': 'current',
    'context': {'form_view_initial_mode': 'edit'},
}
        </field>
    </record>

    <record id="action_whatsapp_config" model="ir.actions.act_window">
        <field name="name">WhatsApp and Email Settings</field>
        <field name="res_model">whatsapp.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

    <!-- ============ OWNER NUMBERS LIST ============ -->
    <record id="view_whatsapp_owner_number_list" model="ir.ui.view">
        <field name="name">whatsapp.owner.number.list</field>
        <field name="model">whatsapp.owner.number</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

</odoo>
