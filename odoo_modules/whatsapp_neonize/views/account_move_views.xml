<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_wa_send" model="ir.ui.view">
        <field name="name">account.move.form.wa.send</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp_invoice_now"
                        string="📱 Send via WhatsApp"
                        type="object"
                        invisible="state != 'posted' or move_type != 'out_invoice'"
                        groups="whatsapp_neonize.group_whatsapp_user"/>
            </xpath>
        </field>
    </record>

</odoo>
