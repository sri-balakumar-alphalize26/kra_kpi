<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_group_list" model="ir.ui.view">
        <field name="name">whatsapp.group.list</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Groups" editable="bottom">
                <field name="name"/>
                <field name="jid"/>
                <field name="subject" optional="show"/>
                <field name="participant_count" optional="show"/>
                <field name="session_id"/>
                <field name="last_refreshed" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_group_form" model="ir.ui.view">
        <field name="name">whatsapp.group.form</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Group display name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="jid"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="participant_count" readonly="1"/>
                            <field name="last_refreshed" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="subject" placeholder="Group subject/topic"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_group" model="ir.actions.act_window">
        <field name="name">WhatsApp Groups</field>
        <field name="res_model">whatsapp.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No WhatsApp groups cached yet.
            </p>
            <p>
                Group metadata is populated automatically as group messages
                arrive. A row appears here as soon as any session receives
                a message from a WhatsApp group.
            </p>
        </field>
    </record>

</odoo>
