<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ SESSION FORM VIEW ============ -->
    <record id="view_whatsapp_session_form" model="ir.ui.view">
        <field name="name">whatsapp.session.form</field>
        <field name="model">whatsapp.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_connect"
                            string="Connect WhatsApp"
                            type="object"
                            class="btn-primary"
                            invisible="status == 'connected'"/>
                    <button name="action_send_message_wizard"
                            string="Send Message"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'connected'"/>
                    <button name="action_disconnect"
                            string="Disconnect"
                            type="object"
                            class="btn-danger"
                            invisible="status != 'connected'"/>
                    <button name="action_refresh_status"
                            string="Refresh Status"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_register_webhook"
                            string="Fix Incoming Messages"
                            type="object"
                            class="btn-warning"
                            invisible="status != 'connected' or webhook_ok"/>
                    <button name="action_resolve_pending_lids"
                            string="🔁 Resolve LIDs"
                            type="object"
                            class="btn-secondary"
                            invisible="status != 'connected'"
                            help="Re-process old messages whose contact phone is a WhatsApp LID (long ID number) and replace it with the real phone."/>
                    <button name="action_capture_phone"
                            string="📱 Capture Phone"
                            type="object"
                            class="btn-secondary"
                            invisible="status != 'connected'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="disconnected,waiting_qr,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-comments">
                            <field name="message_count"
                                   widget="statinfo"
                                   string="Messages"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Company WhatsApp"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="phone_number"/>
                            <field name="country_name" string="Country"/>
                            <field name="country_code" string="Calling Code"/>
                            <field name="auto_reconnect"/>
                        </group>
                        <!-- The Evolution binding. These fields existed on the
                             model from the neonize -> Evolution rewrite but
                             were on no view at all, so "Set the Evolution URL
                             first" named a field nobody could reach. Connect
                             creates the instance and registers the webhook
                             itself, so URL + instance name is all it needs. -->
                        <group string="Evolution API">
                            <field name="base_url"
                                   placeholder="http://localhost:8080"/>
                            <field name="instance_name"
                                   placeholder="e.g. kra-kpi"/>
                            <field name="instance_id"/>
                            <field name="instance_token"/>
                            <field name="send_delay_ms"/>
                        </group>
                        <group string="Settings">
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <!-- Read-only, and worth showing: this is the
                                 address Evolution calls back on. If messages
                                 stop arriving, this is the first thing to
                                 compare against what Evolution has. -->
                            <field name="webhook_url" readonly="1"
                                   widget="CopyClipboardChar"/>
                            <field name="webhook_ok" readonly="1"/>
                            <field name="webhook_checked_at" readonly="1"/>
                            <field name="last_webhook_at" readonly="1"/>
                            <field name="last_state_check" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="status"
                         invisible="base_url">
                        This session is not pointed at Evolution yet. Set the
                        <b>Evolution URL</b> and an <b>Instance Name</b> above,
                        save, then press <b>Connect WhatsApp</b>.
                        <br/>
                        One instance belongs to one session: reusing an
                        instance name that another session already uses makes
                        the two fight over the same webhook.
                    </div>

                    <!-- QR Code Section — Odoo 19: invisible is a Python expression -->
                    <div invisible="status != 'waiting_qr'"
                         class="text-center mt-4 mb-4 p-4"
                         style="background: #f8f9fa; border-radius: 12px;
                                border: 2px dashed #28a745;">
                        <h2 style="color: #28a745;">
                            Scan QR Code with WhatsApp
                        </h2>
                        <p class="text-muted" style="font-size: 16px;">
                            Open WhatsApp on your phone
                            <b>Settings</b> →
                            <b>Linked Devices</b> →
                            <b>Link a Device</b>
                        </p>
                        <div class="d-flex justify-content-center mt-3 mb-3">
                            <field name="qr_image" widget="image"
                                   style="max-width: 300px; max-height: 300px;
                                          border: 3px solid #28a745;
                                          border-radius: 12px;
                                          padding: 10px;
                                          background: white;"/>
                        </div>
                        <field name="qr_last_update" invisible="1"/>
                        <p class="text-muted">
                            <em>Click <b>Refresh Status</b> after scanning the QR code.</em>
                        </p>
                        <p class="text-muted" style="font-size: 12px;">
                            QR code refreshes every ~30 seconds.
                            Click Connect again if it expires.
                        </p>
                    </div>

                    <!-- Connected Banner. Only claims BOTH directions work
                         when the webhook really points here; "connected"
                         alone means the phone is linked, which is only half
                         the story. -->
                    <div invisible="status != 'connected' or not webhook_ok"
                         class="alert alert-success text-center mt-4"
                         role="status"
                         style="font-size: 18px; border-radius: 12px;">
                        <b>WhatsApp Connected Successfully!</b>
                        <br/>
                        <span class="text-muted">
                            You can now send and receive messages.
                        </span>
                    </div>

                    <!-- Linked, but Evolution is delivering somewhere else.
                         Sending works; nothing arrives. This is what a
                         moved database leaves behind, and without a banner
                         the only symptom is silence. -->
                    <div invisible="status != 'connected' or webhook_ok"
                         class="alert alert-danger mt-4"
                         role="alert">
                        <b>Sending works — but nothing can arrive</b>
                        <br/>
                        The phone is linked, yet Evolution is delivering
                        messages to a different address, so everything sent
                        to this number is being dropped.
                        <br/>
                        <span class="text-muted">
                            Evolution is delivering to:
                            <field name="webhook_actual" readonly="1"
                                   nolabel="1"/>
                        </span>
                        <br/>
                        <span class="text-muted">
                            This session expects:
                            <field name="webhook_url" readonly="1"
                                   nolabel="1"/>
                        </span>
                        <br/>
                        Press <b>Fix Incoming Messages</b> above.
                    </div>

                    <!-- Error Banner -->
                    <div invisible="status != 'error'"
                         class="alert alert-danger text-center mt-4"
                         role="alert">
                        <b>Connection Error</b>
                        <br/>
                        <field name="error_message" readonly="1"/>
                    </div>

                    <!-- Why a session went offline on its own. Without this
                         the explanation written by _demote_other_sessions
                         lands in a field only shown on the 'error' banner,
                         so a session switched off by another one connecting
                         just reads "Disconnected" with no reason given. -->
                    <div invisible="status != 'disconnected' or not error_message"
                         class="alert alert-warning mt-4"
                         role="status">
                        <b>This session is not the active one</b>
                        <br/>
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </div>

                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="message_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Time"/>
                                    <field name="direction"/>
                                    <field name="phone"/>
                                    <field name="partner_id"/>
                                    <field name="message"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical"
                              groups="base.group_no_one">
                            <group>
                                <field name="db_path"/>
                                <field name="error_message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ SESSION LIST VIEW ============ -->
    <record id="view_whatsapp_session_list" model="ir.ui.view">
        <field name="name">whatsapp.session.list</field>
        <field name="model">whatsapp.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone_number"/>
                <!-- Which Evolution instance this row drives. Without it two
                     sessions look identical in the list and the only way to
                     tell which one is the live one is to open both. -->
                <field name="instance_name" string="Instance"/>
                <field name="country_name" string="Country" optional="hide"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
                <field name="auto_reconnect" optional="hide"/>
                <field name="status" widget="badge"/>
                <field name="last_webhook_at" string="Last Message In"
                       optional="show"/>
                <field name="message_count" string="Messages"/>
            </list>
        </field>
    </record>

    <!-- ============ SESSION ACTION ============ -->
    <record id="action_whatsapp_session" model="ir.actions.act_window">
        <field name="name">WhatsApp Sessions</field>
        <field name="res_model">whatsapp.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp Session
            </p>
            <p>
                Click the button to create a session, then scan the
                QR code with your WhatsApp app to connect.
            </p>
        </field>
    </record>

</odoo>
