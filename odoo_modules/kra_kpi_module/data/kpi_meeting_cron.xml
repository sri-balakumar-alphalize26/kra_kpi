<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Every 5 minutes: post the join link for a CONFIRMED meeting that
             is about to start, and move it to Opened.

             This is the "automatically opened meeting". It opens what a human
             already confirmed - it never creates, confirms, reschedules or
             cancels anything, and it will not shout "starting now" about a
             meeting that was due two hours ago.

             Lead time: ir.config_parameter kra_kpi.meet_open_lead_minutes
             (default 10).
             See models/kpi_meeting.py _cron_open_meetings. -->
        <record id="ir_cron_kpi_meeting_open" model="ir.cron">
            <field name="name">KRA/KPI: Open confirmed meetings (post the link)</field>
            <field name="model_id" ref="model_kpi_meeting"/>
            <field name="state">code</field>
            <field name="code">model._cron_open_meetings()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Every 15 minutes: one reminder, about an hour ahead.
             kra_kpi.meet_remind_minutes (default 60). Sent once - the
             reminder_sent_at stamp is what stops it nagging. -->
        <record id="ir_cron_kpi_meeting_remind" model="ir.cron">
            <field name="name">KRA/KPI: Remind about upcoming meetings</field>
            <field name="model_id" ref="model_kpi_meeting"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_meetings()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Every 5 minutes: close a room we stopped hearing from.

             A tab killed, a laptop shut, a phone losing signal - no leave
             event ever arrives and the meeting would sit at Opened forever.
             The end time used is the LAST EVENT WE HEARD, never "now":
             recording a meeting as having run until the cron noticed would
             invent minutes onto the record.

             Silence window: ir.config_parameter kra_kpi.meet_silence_minutes
             (default 10). See models/kpi_meeting.py _cron_close_stale_meetings. -->
        <record id="ir_cron_kpi_meeting_close_quiet" model="ir.cron">
            <field name="name">KRA/KPI: Close meetings that went quiet</field>
            <field name="model_id" ref="model_kpi_meeting"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_stale_meetings()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
