<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Every 5 minutes: post the join link for a CONFIRMED meeting that
             is about to start, and move it to Opened.

             This is the "automatically opened meeting". It opens what a human
             already confirmed - it never creates, confirms, reschedules or
             cancels anything, and it will not shout "starting now" about a
             meeting that was due two hours ago.

             Lead time: ir.config_parameter kra_kpi.meet_open_lead_minutes
             (default 10).
             See models/kpi_meeting.py _cron_open_meetings. -->
        <record id="ir_cron_kpi_meeting_open" model="ir.cron">
            <field name="name">KRA/KPI: Open confirmed meetings (post the link)</field>
            <field name="model_id" ref="model_kpi_meeting"/>
            <field name="state">code</field>
            <field name="code">model._cron_open_meetings()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Every 15 minutes: one reminder, about an hour ahead.
             kra_kpi.meet_remind_minutes (default 60). Sent once - the
             reminder_sent_at stamp is what stops it nagging. -->
        <record id="ir_cron_kpi_meeting_remind" model="ir.cron">
            <field name="name">KRA/KPI: Remind about upcoming meetings</field>
            <field name="model_id" ref="model_kpi_meeting"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_meetings()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Every 5 minutes: close a room we stopped hearing from.

             A tab killed, a laptop shut, a phone losing signal - no leave
             event ever arrives and the meeting would sit at Opened forever.
             The end time used is the LAST EVENT WE HEARD, never "now":
             recording a meeting as having run until the cron noticed would
             invent minutes onto the record.

             Every minute it also settles the silence popup ("Continue?").
             Timings: Configuration > Meetings (kra_kpi.meet_gone_min,
             meet_ask_after_min, meet_reply_sec). Silence alone never closes a
             meeting. See models/kpi_meeting.py _cron_close_stale_meetings. -->
        <record id="ir_cron_kpi_meeting_close_quiet" model="ir.cron">
            <field name="name">KRA/KPI: Meetings: silence check and closing empty rooms</field>
            <field name="model_id" ref="model_kpi_meeting"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_stale_meetings()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Every minute: restart a recorder that should be running.

             The recorder is normally launched the moment somebody joins, so
             this is only for the case that path cannot cover: Odoo
             restarting in the middle of a recorded meeting leaves bot_pid
             pointing at a process that no longer exists, and nothing would
             ever notice.

             It only ever STARTS a recorder for a meeting that is live and
             already ticked. It never ticks anything, and it never records a
             meeting nobody asked to record.
             See models/kpi_meeting.py _cron_recorder_watchdog. -->
        <record id="ir_cron_kpi_meeting_recorder" model="ir.cron">
            <field name="name">KRA/KPI: Keep meeting recorders running</field>
            <field name="model_id" ref="model_kpi_meeting"/>
            <field name="state">code</field>
            <field name="code">model._cron_recorder_watchdog()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Daily: delete audio that has already been written up.

             Only the audio. The transcript and the summary stay. A recording
             is kept until there IS a summary, so a transcription that failed
             quietly cannot take the evidence with it.

             Retention: ir.config_parameter kra_kpi.meet_record_keep_days
             (default 180; 0 disables the purge entirely).
             See models/kpi_meeting.py _cron_purge_old_recordings. -->
        <record id="ir_cron_kpi_meeting_purge_audio" model="ir.cron">
            <field name="name">KRA/KPI: Delete meeting audio already summarised</field>
            <field name="model_id" ref="model_kpi_meeting"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_old_recordings()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
