<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily cleanup — clears the End-Workday summary IMAGE
             (kpi.workday.snapshot.image, a filestore attachment) for days older
             than the company's configured retention window
             (res.company.kpi_snapshot_retention_number / _unit, default 3 months;
             0 = keep forever). Only the PNG is freed — the lightweight stats row
             is kept. Editable in the app's Configuration screen. See
             models/kpi_workday_snapshot.py._gc_snapshot_images. -->
        <record id="ir_cron_kpi_snapshot_cleanup" model="ir.cron">
            <field name="name">KRA/KPI: Clear old workday snapshot images</field>
            <field name="model_id" ref="model_kpi_workday_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._gc_snapshot_images()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
