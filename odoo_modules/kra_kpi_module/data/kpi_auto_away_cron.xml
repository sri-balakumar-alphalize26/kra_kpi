<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- INACTIVE BY DEFAULT.

             This paused a developer's running task when their board heartbeat
             went stale (tab closed / laptop asleep) beyond
             company.away_after_minutes, and un-paired their device with it. With
             the default of 5 minutes, shutting a laptop lid cost a developer
             their board and made them re-pair with a PIN from their phone. A
             sleeping machine is not evidence that someone stopped working.

             Kept, not deleted, so a company that wants strict idle pausing can
             set res.company.away_after_minutes and re-activate this record.
             Both are required: the method returns early on 0. -->
        <record id="ir_cron_kpi_auto_away" model="ir.cron">
            <field name="name">KPI: Auto-Away idle developers</field>
            <field name="model_id" ref="model_kpi_work_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_away()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
