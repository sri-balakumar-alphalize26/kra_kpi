<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Gate cron — runs every 15 min but only ACTS once per day, at/after the
             company's configured IST send time (res.company.kpi_daily_report_hour,
             default 10:00). It generates the consolidated daily employee task report
             PDF for the covered day (previous day by default) and sends the admins an
             in-app "report ready" notification + push. A last-sent guard
             (res.company.kpi_daily_report_last_sent) stops it re-sending the same day.
             The server clock is UTC; the method converts to IST so the hour means IST.
             Disabled via res.company.kpi_daily_report_enabled. See
             models/kpi_daily_report.py._cron_daily_report. -->
        <record id="ir_cron_kpi_daily_report" model="ir.cron">
            <field name="name">KRA/KPI: Send daily employee task report (PDF)</field>
            <field name="model_id" ref="model_kpi_daily_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_report()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Daily cleanup — deletes generated report PDFs older than the company's
             configured retention (res.company.kpi_report_retention_number / _unit,
             default 3 months; 0 = keep forever). Whole record. Editable in the app's
             Configuration screen. See models/kpi_daily_report.py._gc_reports. -->
        <record id="ir_cron_kpi_daily_report_cleanup" model="ir.cron">
            <field name="name">KRA/KPI: Delete old daily report PDFs</field>
            <field name="model_id" ref="model_kpi_daily_report"/>
            <field name="state">code</field>
            <field name="code">model._gc_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
