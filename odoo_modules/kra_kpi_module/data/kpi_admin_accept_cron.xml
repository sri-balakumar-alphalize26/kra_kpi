<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RETIRED (19.0.8.6). This accepted tasks whose admin acceptance window
         had elapsed. Nothing is accepted automatically any more: a waiting task
         climbs the approval chain (models/kpi_escalation.py, its own cron),
         which reminds the last step but never accepts.
         _cron_admin_accept_timeout is now a no-op.

         Stays noupdate="1": an upgrade honours the noupdate flag stored at
         first install (see kpi_partial_timeout_cron.xml), so active=False here
         only reaches fresh installs. migrations/19.0.8.6/post-migrate.py
         switches it off on a deployed database. -->
    <data noupdate="1">
        <record id="ir_cron_kpi_admin_accept" model="ir.cron">
            <field name="name">KRA/KPI: Auto-accept tasks no admin actioned (RETIRED)</field>
            <field name="model_id" ref="model_kra_kpi"/>
            <field name="state">code</field>
            <field name="code">model._cron_admin_accept_timeout()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
