<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Every 5 minutes: for tasks whose currently-pinged client hasn't
             decided within 30 min, fire pre_approval_request again to roll
             to the next client on the KRA. See models/kpi_workflow.py
             _cron_escalate_pre_approval. -->
        <record id="ir_cron_kpi_pre_approval_escalate" model="ir.cron">
            <field name="name">KRA/KPI: Escalate pre-approval to next client after 30 min</field>
            <field name="model_id" ref="model_kra_kpi"/>
            <field name="state">code</field>
            <field name="code">model._cron_escalate_pre_approval()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
