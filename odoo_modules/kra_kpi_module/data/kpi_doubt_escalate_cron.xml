<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Every minute: a developer's question, a meeting request or a
             client's Discuss message nobody answered within its Approval Chain
             tier goes to the next tier (Settings > Approval Chain).
             See models/kpi_doubt.py _cron_escalate_doubts. -->
        <record id="ir_cron_kpi_doubt_escalate" model="ir.cron">
            <field name="name">KRA/KPI: Questions, ask the next tier</field>
            <field name="model_id" ref="model_kpi_doubt"/>
            <field name="state">code</field>
            <field name="code">model._cron_escalate_doubts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
