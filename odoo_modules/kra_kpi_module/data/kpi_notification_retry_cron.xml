<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Retry queue cron — runs every minute, attempts to deliver any
             notification that previously failed because the WhatsApp socket
             was zombie.  Mirrors the in-memory-state check the POS WhatsApp
             integration uses.  See models/kpi_notification_queue.py for
             the lifecycle. -->
        <record id="ir_cron_kpi_notification_retry" model="ir.cron">
            <field name="name">KRA/KPI: Retry failed WhatsApp notifications</field>
            <field name="model_id" ref="model_kpi_notification_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
