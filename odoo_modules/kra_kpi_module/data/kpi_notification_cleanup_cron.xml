<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily cleanup — deletes in-app notifications (kpi.notification) older
             than 30 days so the feed stays recent and the table small. The mobile
             feed shows the newest rows; anything past 30 days is dropped here. -->
        <record id="ir_cron_kpi_notification_cleanup" model="ir.cron">
            <field name="name">KRA/KPI: Delete notifications older than 30 days</field>
            <field name="model_id" ref="model_kpi_notification"/>
            <field name="state">code</field>
            <field name="code">model._gc_notifications(30)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
