<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- App notifications added 19.0.8.7 (models/kpi_notify_more.py). -->
    <data noupdate="1">
        <record id="ir_cron_kpi_timer_nudges" model="ir.cron">
            <field name="name">KRA/KPI: 80% of estimate / task still running in the evening</field>
            <field name="model_id" ref="model_kra_kpi"/>
            <field name="state">code</field>
            <field name="code">model._cron_timer_nudges()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_kpi_review_closing" model="ir.cron">
            <field name="name">KRA/KPI: client review closes tomorrow</field>
            <field name="model_id" ref="model_kra_kpi"/>
            <field name="state">code</field>
            <field name="code">model._cron_review_closing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_kpi_invoice_overdue" model="ir.cron">
            <field name="name">KRA/KPI: invoice overdue</field>
            <field name="model_id" ref="model_kpi_client_invoice"/>
            <field name="state">code</field>
            <field name="code">model._cron_invoice_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
