<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily: warn owners and coordinators about database terms that are
             about to expire (30 / 7 / 1 days out, and the day it passes).

             THIS CRON CHANGES NO STATE. It does not suspend, disconnect, or
             touch a single database, and it says nothing to the client. A
             client's live shop does not stop working because a date arrived;
             that is a conversation between people, and acting on it is an
             admin pressing a button on the Live Databases screen.

             Rows with "Track term" unticked are skipped entirely — which is
             the default, so a shop that does not sell on terms never hears
             from this job at all.

             See models/kpi_client_db.py _cron_db_term_check. -->
        <record id="ir_cron_kpi_db_term_check" model="ir.cron">
            <field name="name">KRA/KPI: Warn about expiring database terms</field>
            <field name="model_id" ref="model_kpi_client_db"/>
            <field name="state">code</field>
            <field name="code">model._cron_db_term_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
