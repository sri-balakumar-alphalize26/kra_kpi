<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Every minute: re-notify owner + coordinators about a task a developer
             🚨 Urgent-paused, for as long as their `urgent_pause` notification is
             still UNREAD. The moment any admin opens it, nudging stops — as does
             the moment the developer resumes/completes the task.

             Runs every MINUTE (unlike the 5-minute queue-nudge cron) so the gap is
             accurate: an urgent alert shouldn't drift. The actual gap between
             nudges is res.company.urgent_nudge_minutes (default 5) — editable in
             Configuration → Timers & Away — and the repeats are capped by
             kra.kpi.URGENT_NUDGE_MAX.
             See models/kpi_workflow.py _cron_nudge_urgent_pause. -->
        <record id="ir_cron_kpi_urgent_nudge" model="ir.cron">
            <field name="name">KRA/KPI: Re-nudge admins about unread urgent pauses</field>
            <field name="model_id" ref="model_kra_kpi"/>
            <field name="state">code</field>
            <field name="code">model._cron_nudge_urgent_pause()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
