<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Every minute, flip any 'pre_approval_pending' task whose
             pre_approval_deadline_at has passed to 'pre_approval_partial'.
             Idempotent: the handler filters on task_state so re-runs
             don't double-fire.  See models/kpi_workflow.py. -->
        <record id="ir_cron_kpi_pre_approval_timeout" model="ir.cron">
            <field name="name">KRA/KPI: Auto-flip pre-approval to partial after 5 min</field>
            <field name="model_id" ref="model_kra_kpi"/>
            <field name="state">code</field>
            <field name="code">model._cron_pre_approval_timeout()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
