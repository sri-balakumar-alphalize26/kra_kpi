<?xml version="1.0" encoding="UTF-8"?>
<templates id="kra_tree_templates" xml:space="preserve">

    <t t-name="KraTree">
        <div>
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <span class="spinner-border text-primary"></span>
                </div>
            </t>

            <t t-else="">
                <div class="ps-2">
                    <t t-foreach="state.kra_list" t-as="kra" t-key="kra.id">
                        <KraNode kra="kra"/>
                    </t>
                </div>
            </t>
        </div>
    </t>

    <t t-name="KraNode">
        <div class="mb-2">

            <div class="d-flex align-items-center">
                <span class="me-2" t-on-click="toggle">
                    <t t-if="props.kra.child_ids.length > 0">
                        <i class="fa"
                           t-att-class="state.open ? 'fa-folder-open text-warning' : 'fa-folder text-warning'">
                        </i>
                    </t>
                    <t t-else="">
                        <i class="fa fa-folder text-muted"></i>
                    </t>
                </span>

                <span class="fw-bold" t-esc="props.kra.name"/>

                <!-- 🔥 Delete KRA button -->
                <span class="ms-2 text-danger small"
                      t-on-click="() => deleteKra(props.kra.id)"
                      title="Delete this KRA">
                    <i class="fa fa-trash"></i>
                </span>
            </div>

            <t t-if="state.open">
                <div class="ms-4">

                    <t t-foreach="props.kra.child_ids" t-as="child" t-key="child.id">
                        <KraNode kra="child"/>
                    </t>

                    <t t-foreach="props.kra.kpi_ids" t-as="kpi" t-key="kpi.id">
                        <div class="ms-4 py-1 d-flex align-items-center">
                            <i class="fa fa-circle text-primary me-2" style="font-size: 7px;"></i>
                            <span t-esc="kpi.name"></span>

                            <!-- 🔥 Delete KPI button -->
                            <span class="ms-2 text-danger small"
                                  t-on-click="() => deleteKpi(kpi.id)"
                                  title="Delete this KPI">
                                <i class="fa fa-trash"></i>
                            </span>
                        </div>
                    </t>

                </div>
            </t>

        </div>
    </t>

</templates>
