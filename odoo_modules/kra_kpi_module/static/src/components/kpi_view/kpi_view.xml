<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="KpiView">
        <div class="o_kpi_view p-3">

            <!-- Render ONLY when KPI is loaded -->
            <t t-if="state.kpi">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold">KPI Details</h3>
                    <div>
                        <button class="btn btn-light me-2" t-on-click="back">Back</button>
                    </div>
                </div>

                <div class="card p-3">
                    <div class="container-fluid">

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Name</div>
                            <div class="col-9" t-esc="state.kpi.name or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">KRA</div>
                            <div class="col-9" t-esc="state.kpi.kra_name or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Priority</div>
                            <div class="col-9" t-esc="state.kpi.priority or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Unit</div>
                            <div class="col-9" t-esc="state.kpi.unit or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Estimate</div>
                            <div class="col-9" t-esc="state.kpi.estimate or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Points</div>
                            <div class="col-9" t-esc="state.kpi.points or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Assignee</div>
                            <div class="col-9" t-esc="state.kpi.user_name or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">User Group</div>
                            <div class="col-9" t-esc="state.kpi.user_group_name or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Deadline</div>
                            <div class="col-9" t-esc="state.kpi.deadline or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Reminder Days</div>
                            <div class="col-9" t-esc="state.kpi.reminder_days or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Next KPI</div>
                            <div class="col-9" t-esc="state.kpi.next_kpi_name or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Warehouse</div>
                            <div class="col-9" t-esc="state.kpi.warehouse or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">File Name</div>
                            <div class="col-9" t-esc="state.kpi.file_name or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Actions</div>
                            <div class="col-9" t-esc="state.kpi.actions or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Description</div>
                            <div class="col-9" t-esc="state.kpi.description or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Checklist</div>
                            <div class="col-9" t-esc="state.kpi.checklist or '-'"/>
                        </div>

                        <div class="row mb-2">
                            <div class="col-3 fw-bold">Guidelines</div>
                            <div class="col-9" t-esc="state.kpi.guidelines or '-'"/>
                        </div>

                    </div>
                </div>

                <div class="mt-3 p-3">
                    <div class="fw-bold">Debug (loaded KPI object)</div>
                    <pre style="white-space: pre-wrap; word-break: break-word;">
<t t-esc="state.kpi_json or '{}'"/>
                    </pre>
                </div>

            </t>

            <!-- Loading indicator -->
            <t t-else="">
                <div class="alert alert-info">Loading KPI...</div>
            </t>

        </div>
    </t>

</templates>
