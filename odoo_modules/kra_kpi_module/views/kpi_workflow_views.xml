<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             Inherit the existing kra.kpi form view to surface the Client
             Pre-Approval flow:
               * Header button "Request Client Pre-Approval" that calls
                 request_client_pre_approval() on the record.
               * Read-only "Client Pre-Approval" notebook page exposing the
                 decision, decided_by, source, timestamp, feedback and the
                 token + link so the coordinator can copy it manually if
                 they want to test outside WhatsApp.
             ============================================================ -->
        <record id="view_kra_kpi_form_workflow_inherit" model="ir.ui.view">
            <field name="name">kra.kpi.form.workflow.inherit</field>
            <field name="model">kra.kpi</field>
            <field name="inherit_id" ref="kra_kpi_module.view_kra_kpi_form"/>
            <field name="arch" type="xml">

                <!-- Add a header above the sheet with the action button. -->
                <xpath expr="//sheet" position="before">
                    <header>
                        <button name="request_client_pre_approval"
                                type="object"
                                string="Request Client Pre-Approval"
                                class="btn-primary"
                                invisible="task_state in ('completed', 'awaiting_client')"/>
                        <field name="task_state" widget="statusbar"
                               statusbar_visible="assigned,pre_approval_pending,pre_approval_approved,in_progress,partially_completed,awaiting_client,completed"/>
                    </header>
                </xpath>

                <!-- Make `task_state` visible (it was invisible before) so the
                     header statusbar can paint it.  Drop the duplicate
                     invisible field at the bottom of the sheet. -->
                <xpath expr="//sheet//field[@name='task_state']" position="replace">
                    <!-- moved into header; placeholder kept so xpath order is stable -->
                </xpath>

                <!-- Append a notebook page with the pre-approval fields. -->
                <xpath expr="//notebook" position="inside">
                    <page string="Client Pre-Approval" name="page_pre_approval">
                        <group>
                            <group string="Decision">
                                <field name="pre_approval_decision" readonly="1"/>
                                <field name="pre_approval_decided_by_name" readonly="1"/>
                                <field name="pre_approval_decided_at" readonly="1"/>
                                <field name="pre_approval_source" readonly="1"/>
                                <field name="pre_approval_decided_by_partner_id" readonly="1"
                                       invisible="not pre_approval_decided_by_partner_id"/>
                            </group>
                            <group string="Token + Deadline">
                                <field name="approval_token" readonly="1"/>
                                <field name="approval_token_expires" readonly="1"/>
                                <field name="approval_token_used" readonly="1"/>
                                <field name="pre_approval_deadline_at" readonly="1"/>
                            </group>
                        </group>
                        <group string="Feedback (reject / hold / clarify)">
                            <field name="pre_approval_feedback" nolabel="1" readonly="1"
                                   placeholder="Client's optional comment lands here"/>
                        </group>
                    </page>
                    <page string="Pause / Workflow" name="page_workflow_misc">
                        <group>
                            <group string="Pause">
                                <field name="pause_reason_code"/>
                                <field name="paused_reason"/>
                            </group>
                            <group string="Queue">
                                <field name="queue_position"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

        <!-- ============================================================
             kpi.action.log — backend list + form view + menu.
             ACL'd to admin + owner (read-only via ir.model.access.csv).
             ============================================================ -->
        <record id="view_kpi_action_log_list" model="ir.ui.view">
            <field name="name">kpi.action.log.list</field>
            <field name="model">kpi.action.log</field>
            <field name="arch" type="xml">
                <list string="KPI Action Log" decoration-danger="not success" default_order="create_date desc">
                    <field name="create_date" string="When"/>
                    <field name="kpi_id"/>
                    <field name="event"/>
                    <field name="source" widget="badge"
                           decoration-info="source == 'web'"
                           decoration-success="source == 'whatsapp'"
                           decoration-warning="source == 'cron'"
                           decoration-muted="source == 'system'"/>
                    <field name="actor_user_id" optional="show"/>
                    <field name="actor_label" optional="show"/>
                    <field name="device_ip" optional="hide"/>
                    <field name="success" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_kpi_action_log_form" model="ir.ui.view">
            <field name="name">kpi.action.log.form</field>
            <field name="model">kpi.action.log</field>
            <field name="arch" type="xml">
                <form string="KPI Action Log" create="false" edit="false" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="kpi_id"/>
                                <field name="event"/>
                                <field name="source"/>
                                <field name="success"/>
                            </group>
                            <group>
                                <field name="create_date"/>
                                <field name="actor_user_id"/>
                                <field name="actor_partner_id"/>
                                <field name="actor_label"/>
                                <field name="device_ip"/>
                                <field name="user_agent"/>
                            </group>
                        </group>
                        <group string="Payload">
                            <field name="payload_json" nolabel="1" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_kpi_action_log_search" model="ir.ui.view">
            <field name="name">kpi.action.log.search</field>
            <field name="model">kpi.action.log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="kpi_id"/>
                    <field name="event"/>
                    <field name="actor_label"/>
                    <field name="device_ip"/>
                    <filter name="filter_success" string="Successful" domain="[('success','=',True)]"/>
                    <filter name="filter_failed"  string="Failed"      domain="[('success','=',False)]"/>
                    <filter name="filter_web"      string="Web"      domain="[('source','=','web')]"/>
                    <filter name="filter_whatsapp" string="WhatsApp" domain="[('source','=','whatsapp')]"/>
                    <filter name="filter_cron"     string="Cron"     domain="[('source','=','cron')]"/>
                    <filter name="filter_system"   string="System"   domain="[('source','=','system')]"/>
                    <filter name="group_event"  string="Event"  context="{'group_by':'event'}"/>
                    <filter name="group_source" string="Source" context="{'group_by':'source'}"/>
                    <filter name="group_kpi"    string="Task"   context="{'group_by':'kpi_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_kpi_action_log" model="ir.actions.act_window">
            <field name="name">Action Log</field>
            <field name="res_model">kpi.action.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_kpi_action_log_search"/>
            <field name="context">{'search_default_filter_failed': 0}</field>
        </record>

        <menuitem id="menu_kpi_action_log"
                  name="Action Log"
                  parent="menu_kpi_settings"
                  action="action_kpi_action_log"
                  sequence="60"
                  groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    </data>
</odoo>
