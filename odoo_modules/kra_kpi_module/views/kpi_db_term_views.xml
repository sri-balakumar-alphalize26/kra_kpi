<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
         Database terms. Entirely optional: a term only ever applies to a
         database whose "Track term" box is ticked, and that box is off by
         default. Edit this list freely - nothing in the code matches on a
         term's name.
    -->

    <record id="view_kpi_db_term_list" model="ir.ui.view">
        <field name="name">kpi.db.term.list</field>
        <field name="model">kpi.db.term</field>
        <field name="arch" type="xml">
            <list string="Database Terms" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="months"/>
                <field name="days"/>
                <field name="is_perpetual" string="Never expires"/>
                <field name="length_display" string="Length"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_kpi_db_term_form" model="ir.ui.view">
        <field name="name">kpi.db.term.form</field>
        <field name="model">kpi.db.term</field>
        <field name="arch" type="xml">
            <form string="Database Term">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Term"/>
                        <h1><field name="name" placeholder="e.g. Quarterly"/></h1>
                    </div>
                    <group>
                        <group string="Length">
                            <field name="is_perpetual"/>
                            <field name="months" invisible="is_perpetual"/>
                            <field name="days" invisible="is_perpetual"/>
                            <field name="length_display"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="What this includes, what it costs, who agreed it. Internal only."/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Months and days add together, so a one-month term with a
                        week's grace is <b>1 month + 7 days</b>. The expiry date
                        this produces is only a <b>suggestion</b> - it is editable
                        on each database, because a real agreement rarely matches
                        the arithmetic.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kpi_db_term" model="ir.actions.act_window">
        <field name="name">Database Terms</field>
        <field name="res_model">kpi.db.term</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Define how long a database is paid up for</p>
            <p>
                Weekly, monthly, yearly, lifetime - whatever you actually sell.
                These are <b>optional</b>: a term applies only to a database whose
                <b>Track term</b> box is ticked, and that is off by default.
            </p>
        </field>
    </record>

</odoo>
