<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add a "KRA / KPI Role" radio (User / Client / Admin) to Settings ->
         Users & Companies -> Users, right under the base "Role: User /
         Administrator". Picking one assigns the matching KRA/KPI group. -->
    <record id="view_users_form_kpi_role" model="ir.ui.view">
        <field name="name">res.users.form.kpi.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//field[@name='role']" position="after">
                <field name="kpi_role" string="KRA / KPI Role"
                       widget="radio" options="{'horizontal': true}"
                       invisible="share"/>
                <!-- kpi_wa_number existed on the model but on NO view, and the
                     only route that wrote it (/kpi_multitask/set_wa) lists
                     developers only. A coordinator or owner therefore could
                     not be given a WhatsApp number at all, which is the same
                     as saying they cannot be sent an approval. One field, one
                     screen, every role. -->
                <field name="kpi_wa_number" string="WhatsApp number"
                       invisible="share"
                       placeholder="e.g. 919876543210 — with the country code"/>
                <div class="text-muted" colspan="2" invisible="share">
                    Approvals, assignment notices and urgent alerts are sent
                    here. Include the country code; without it the number
                    cannot be dialled and the message is never delivered.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Same role as a COLUMN in the Users list, next to the base "Role" column,
         so you can see who is Admin / Client / User without opening each user.
         kpi_role is compute+inverse and store=False, so it cannot be sorted or
         searched on — hence no optional="hide" toggle games, just a plain
         read-only column. -->
    <record id="view_users_tree_kpi_role" model="ir.ui.view">
        <field name="name">res.users.list.kpi.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="kpi_role" string="KRA / KPI Role"
                       widget="badge" readonly="1" optional="show"/>
                <!-- So "who can actually be messaged?" is answerable by
                     looking, rather than by opening twelve user records. -->
                <field name="kpi_wa_number" string="WhatsApp"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
