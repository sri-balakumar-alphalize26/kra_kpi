<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- WhatsApp "➕ Create my own task": the web app's New Task dialog
             (web/components/task/dialogs.jsx, theme web/app/themes/tokens.css)
             as a page opened from a one-person, 30-minute link. Same fields and
             rules (kra.kpi.self_create_task), same Pending review flow. -->
        <template id="wa_task_layout" name="WA Task Page Layout">
            <html lang="en">
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <title t-esc="page_title or 'New task'"/>
                    <style>
                        :root { --canvas:#F7F9FC; --surface:#FFFFFF; --border:#E5E9F0; --text:#1F2937;
                                --subtle:#374151; --subtlest:#6B7280; --brand:#1E40AF; --on-brand:#FFFFFF;
                                --sel-bg:#E0ECFF; --sel-text:#1E40AF; --input:#F4F7FB; --hover:#F1F5FB;
                                --danger:#DC2626; --ok:#15803D; --ok-bg:#DCFCE7; --r:8px; --r-card:12px;
                                --font:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif; }
                        * { box-sizing:border-box; }
                        body { margin:0; padding:16px; background:var(--canvas); color:var(--text);
                               font:14px/1.45 var(--font); -webkit-text-size-adjust:100%; }
                        .card { max-width:620px; margin:16px auto; background:var(--surface);
                                border:1px solid var(--border); border-radius:var(--r-card);
                                box-shadow:0 8px 28px rgba(16,24,40,.08); overflow:hidden; }
                        .hd { padding:16px 20px; border-bottom:1px solid var(--border); font-size:17px; font-weight:800; }
                        .hd small { display:block; font-weight:500; font-size:12.5px; color:var(--subtlest); margin-top:2px; }
                        .bd { padding:18px 20px; display:flex; flex-direction:column; gap:14px; }
                        .ft { padding:14px 20px; border-top:1px solid var(--border); display:flex; justify-content:flex-end; gap:8px; }
                        .grid2 { display:grid; grid-template-columns:1fr; gap:14px; }
                        @media (min-width:520px) { .grid2 { grid-template-columns:1fr 1fr; } }
                        .field { display:flex; flex-direction:column; gap:6px; }
                        .lbl { font-size:12.5px; font-weight:700; color:var(--subtle); }
                        .lbl .req { color:var(--danger); }
                        .hint { font-size:12px; color:var(--subtlest); }
                        .input, select, textarea { width:100%; min-height:40px; padding:9px 12px; font:inherit; color:inherit;
                                background:var(--input); border:1px solid var(--border); border-radius:var(--r); outline:0; }
                        .input:focus, select:focus, textarea:focus { border-color:var(--brand); box-shadow:0 0 0 3px var(--sel-bg); background:#fff; }
                        textarea { min-height:90px; resize:vertical; }
                        .hm { display:flex; gap:6px; }
                        .hm span { position:relative; flex:1; }
                        .hm span i { position:absolute; right:12px; top:10px; font-style:normal; color:var(--subtlest); }
                        .tabs { display:inline-flex; background:var(--input); border:1px solid var(--border);
                                border-radius:var(--r); padding:3px; gap:2px; flex-wrap:wrap; }
                        .tabs input { display:none; }
                        .tabs label { padding:6px 14px; border-radius:6px; font-weight:700; font-size:13px;
                                      color:var(--subtle); cursor:pointer; user-select:none; }
                        .tabs input:checked + label { background:var(--surface); color:var(--sel-text);
                                      box-shadow:0 1px 3px rgba(16,24,40,.12); }
                        .chks { display:flex; gap:16px; flex-wrap:wrap; padding-top:4px; }
                        .chks label { display:flex; align-items:center; gap:6px; font-weight:600; }
                        .chks input { width:16px; height:16px; accent-color:var(--brand); }
                        .err { color:var(--danger); font-size:12.5px; font-weight:700; }
                        .mini { font-size:12.5px; color:var(--subtlest); margin:0; }
                        .btn { min-height:40px; padding:0 18px; border-radius:var(--r); font:inherit; font-weight:700;
                               cursor:pointer; border:1px solid transparent; }
                        .btn.primary { background:var(--brand); color:var(--on-brand); }
                        .btn.ghost { background:transparent; color:var(--subtle); border-color:var(--border); }
                        .done { text-align:center; padding:28px 20px; }
                        .done .big { font-size:40px; }
                        .done .ref { display:inline-block; margin-top:8px; padding:3px 10px; border-radius:999px;
                                     background:var(--ok-bg); color:var(--ok); font-weight:800; }
                        .card { border-top:4px solid var(--brand); }
                        /* Our own dropdown (static/src/wa_client_form/picker.js). */
                        .kp { position:relative; }
                        .kp-native { position:absolute !important; opacity:0; pointer-events:none; width:1px !important;
                                     height:1px; min-height:0 !important; padding:0 !important; border:0 !important; }
                        .kp-btn { width:100%; min-height:42px; display:flex; align-items:center; gap:8px; padding:9px 12px;
                                  font:inherit; color:var(--text); text-align:left; cursor:pointer;
                                  background:var(--input); border:1px solid var(--border); border-radius:var(--r); }
                        .kp-btn:hover { border-color:var(--brand); }
                        .kp-btn:focus-visible, .kp-open .kp-btn { outline:0; border-color:var(--brand);
                                  box-shadow:0 0 0 3px var(--sel-bg); background:#fff; }
                        .kp-btn.kp-empty .kp-label { color:var(--subtlest); }
                        .kp-label { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
                        .kp-caret { color:var(--subtlest); transition:transform .15s; }
                        .kp-open .kp-caret { transform:rotate(180deg); }
                        .kp-disabled .kp-btn { opacity:.6; cursor:not-allowed; }
                        .kp-panel { position:absolute; z-index:30; left:0; right:0; top:calc(100% + 6px);
                                    background:var(--surface); border:1px solid var(--border); border-radius:var(--r-card);
                                    box-shadow:0 14px 34px rgba(16,24,40,.16); padding:6px; }
                        .kp-panel[hidden] { display:none; }
                        .kp-search { width:100%; min-height:36px; margin-bottom:6px; padding:7px 10px; font:inherit;
                                     background:var(--input); border:1px solid var(--border); border-radius:var(--r); outline:0; }
                        .kp-search:focus { border-color:var(--brand); }
                        .kp-search[hidden] { display:none; }
                        .kp-list { max-height:260px; overflow-y:auto; display:flex; flex-direction:column; gap:2px; }
                        .kp-opt { display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:var(--r);
                                  cursor:pointer; color:var(--text); }
                        .kp-opt span { flex:1; min-width:0; overflow-wrap:anywhere; }
                        .kp-opt:hover, .kp-opt:focus { background:var(--hover); outline:0; }
                        .kp-opt.on { background:var(--sel-bg); color:var(--sel-text); font-weight:700; }
                        .kp-opt.off { opacity:.45; cursor:not-allowed; }
                        .kp-none { padding:10px 12px; color:var(--subtlest); font-size:13px; }
                    </style>
                    <!-- The person's own colour (kpi_user_color.py), same as their
                         marker in the WhatsApp group. -->
                    <style t-if="theme">
                        :root { --brand:<t t-out="theme"/>; --sel-text:<t t-out="theme"/>; --sel-bg:<t t-out="theme"/>1F; }
                    </style>
                </head>
                <body>
                    <div class="card"><t t-out="0"/></div>
                    <script src="/kra_kpi_module/static/src/wa_client_form/picker.js?v=1"></script>
                    <script src="/kra_kpi_module/static/src/wa_client_form/viewer.js?v=1"></script>
                    <script src="/kra_kpi_module/static/src/wa_client_form/links.js?v=2"></script>
                    <script src="/kra_kpi_module/static/src/wa_client_form/filepick.js?v=1"></script>
                    <script src="/kra_kpi_module/static/src/wa_client_form/dialog.js?v=1"></script>
                </body>
            </html>
        </template>

        <template id="wa_task_form" name="WA New Task Form">
            <t t-call="kra_kpi_module.wa_task_layout">
                <t t-set="page_title" t-value="'New task'"/>
                <form method="post" t-att-action="'/kpi/wa/newtask/%s/create' % token">
                    <div class="hd">New task — Pending review<small>For <t t-esc="user_name"/> · this link works once</small></div>
                    <div class="bd">
                        <div class="grid2">
                            <div class="field">
                                <span class="lbl">Client <span class="req">*</span></span>
                                <select id="ntClient" name="client_id">
                                    <option value="">Choose a client</option>
                                    <t t-foreach="clients" t-as="c">
                                        <option t-att-value="c['id']" t-esc="c['name']"
                                                t-att-selected="'selected' if str(c['id']) == str(values.get('client_id', '')) else None"/>
                                    </t>
                                </select>
                            </div>
                            <div class="field">
                                <span class="lbl">Project / version <span class="req">*</span></span>
                                <select id="ntKra" name="kra_id">
                                    <t t-foreach="projects" t-as="p">
                                        <option t-att-value="p['id']" t-att-data-client="p['client_id']" t-esc="p['display']"
                                                t-att-selected="'selected' if str(p['id']) == str(values.get('kra_id', '')) else None"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="field">
                            <span class="lbl">Task name <span class="req">*</span></span>
                            <input class="input" name="name" maxlength="200" placeholder="What needs doing?"
                                   t-att-value="values.get('name', '')"/>
                        </div>

                        <div class="field">
                            <span class="lbl">Type</span>
                            <span class="tabs">
                                <t t-foreach="[('requirement', 'REQ'), ('update', 'UPT'), ('bug', 'BUG')]" t-as="o">
                                    <input type="radio" name="doc_type" t-att-id="'dt_%s' % o[0]" t-att-value="o[0]"
                                           t-att-checked="'checked' if o[0] == values.get('doc_type', 'requirement') else None"/>
                                    <label t-att-for="'dt_%s' % o[0]" t-esc="o[1]"/>
                                </t>
                            </span>
                            <span class="hint">What you think it is — the admin makes the final call on Accept.</span>
                        </div>

                        <div class="field">
                            <span class="lbl">Module / App / EXE / Other (tick one or more) <span class="req">*</span></span>
                            <span class="chks">
                                <t t-foreach="[('module', 'Module'), ('app', 'App'), ('exe', 'EXE'), ('other', 'Other')]" t-as="dv">
                                    <label><input type="checkbox" name="deliverable_type" t-att-value="dv[0]"
                                                  t-att-id="'ntDeliv_%s' % dv[0]"
                                                  t-att-checked="'checked' if dv[0] in values.get('deliverable', []) else None"/>
                                        <t t-esc="dv[1]"/></label>
                                </t>
                            </span>
                            <!-- Shown while Other is ticked; what they type is saved as the type. -->
                            <input class="input" id="ntDelivOther" name="deliverable_other" maxlength="40"
                                   placeholder="What is it? e.g. Plugin, Website" t-att-value="values.get('deliverable_other') or ''"
                                   t-att-style="None if 'other' in values.get('deliverable', []) else 'display:none'"/>
                        </div>

                        <div class="field">
                            <span class="lbl">Priority</span>
                            <span class="tabs">
                                <t t-foreach="[('regular', 'Regular'), ('important', 'Important'), ('urgent', 'Urgent')]" t-as="o">
                                    <input type="radio" name="priority" t-att-id="'pr_%s' % o[0]" t-att-value="o[0]"
                                           t-att-checked="'checked' if o[0] == values.get('priority', 'regular') else None"/>
                                    <label t-att-for="'pr_%s' % o[0]" t-esc="o[1]"/>
                                </t>
                            </span>
                        </div>

                        <div class="field">
                            <span class="lbl">Estimate (optional)</span>
                            <span class="hm">
                                <span><input class="input" type="number" min="0" name="estimate_hours"
                                             t-att-value="values.get('estimate_hours', '0')"/><i>h</i></span>
                                <span><input class="input" type="number" min="0" max="59" name="estimate_minutes"
                                             t-att-value="values.get('estimate_minutes', '0')"/><i>m</i></span>
                            </span>
                            <span class="hint">The admin can set or correct it when accepting.</span>
                        </div>

                        <div class="field">
                            <span class="lbl">Description (optional)</span>
                            <textarea name="description" t-esc="values.get('description', '')"/>
                        </div>

                        <span t-if="error" class="err" t-esc="error"/>
                        <p class="mini">This goes to your <b>Pending review</b> lane. <b>Start stays locked</b> until
                            an admin accepts it — which happens automatically if nobody acts within the accept window.
                            Your client is then asked to approve, and the task releases for work once they do (or
                            automatically if they don't reply in time).</p>
                    </div>
                    <div class="ft">
                        <button type="button" class="btn ghost" onclick="window.close(); history.back();">Cancel</button>
                        <button type="submit" class="btn primary">Create task</button>
                    </div>
                </form>
                <script>
                    (function () {
                        var c = document.getElementById('ntClient'), k = document.getElementById('ntKra');
                        var all = Array.prototype.slice.call(k.options);
                        function filter() {
                            var keep = k.value, first = null, still = false;
                            all.forEach(function (o) {
                                var show = !c.value || o.getAttribute('data-client') === c.value;
                                o.hidden = !show; o.disabled = !show;
                                if (show) { if (!first) { first = o; } if (o.value === keep) { still = true; } }
                            });
                            if (!still) { k.value = first ? first.value : ''; }
                        }
                        c.addEventListener('change', filter); filter();
                        var other = document.getElementById('ntDeliv_other'), otherText = document.getElementById('ntDelivOther');
                        function showOther() {
                            otherText.style.display = other.checked ? '' : 'none';
                            otherText.required = other.checked;
                            if (other.checked) { otherText.focus(); }
                        }
                        other.addEventListener('change', showOther);
                    })();
                </script>
            </t>
        </template>

        <template id="wa_task_form_done" name="WA New Task Created">
            <t t-call="kra_kpi_module.wa_task_layout">
                <t t-set="page_title" t-value="'Task created'"/>
                <div class="done">
                    <div class="big">✅</div>
                    <div style="font-size:18px; font-weight:800;">Your task is created</div>
                    <span class="ref"><t t-esc="ref"/> — <t t-esc="name"/></span>
                    <p style="margin-top:16px; font-weight:700;">Go back to WhatsApp and check.</p>
                    <p class="mini">It comes to you to start once the admin and the client approve it.</p>
                </div>
            </t>
        </template>
    </data>
</odoo>
