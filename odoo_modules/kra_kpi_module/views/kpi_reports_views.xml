    <!-- kpi_reports_views.xml - UPDATE Employee Salary Master views -->

    <record id="view_kpi_employee_salary_config_list" model="ir.ui.view">
        <field name="name">kpi.employee.salary.config.list</field>
        <field name="model">kpi.employee.salary.config</field>
        <field name="arch" type="xml">
            <list string="Employee Salary Configuration" editable="bottom">
                <field name="employee_id"/>
                <field name="salary" class="text-end"/>
                <field name="working_days" class="text-end"/>
                <field name="attendance_hours_per_day" class="text-end"/>
                <field name="available_hours" readonly="1" optional="show" class="text-end"/>
                <field name="available_units" readonly="1" optional="show" class="text-end"/>
                <field name="unit_cost" readonly="1" optional="show" class="text-end"/>
                <field name="last_updated" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kpi_employee_salary_config_form" model="ir.ui.view">
        <field name="name">kpi.employee.salary.config.form</field>
        <field name="model">kpi.employee.salary.config</field>
        <field name="arch" type="xml">
            <form string="Employee Salary Configuration">
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="employee_id"/>
                            <field name="salary"/>
                            <field name="working_days"/>
                            <field name="attendance_hours_per_day"/>
                        </group>
                        <group string="Calculated Values (Auto)">
                            <field name="available_hours" readonly="1"/>
                            <field name="available_units" readonly="1"/>
                            <field name="unit_cost" readonly="1"/>
                            <field name="last_updated" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Formula Reference">
                            <group>
                                <div class="alert alert-info">
                                    <h4>📊 Calculation Formulas</h4>
                                    <ul>
                                        <li><strong>Available Hours</strong> = Working Days × Attendance Hours/Day</li>
                                        <li><strong>Available Units</strong> = Available Hours × 100</li>
                                        <li><strong>Unit Cost</strong> = Salary / Available Units</li>
                                        <li><strong>Note:</strong> 1 unit = 0.01 hours (100 units = 1 hour)</li>
                                    </ul>
                                    
                                    <h5 class="mt-3">Example:</h5>
                                    <ul>
                                        <li>Salary: ₹20,000</li>
                                        <li>Working Days: 25</li>
                                        <li>Attendance Hours/Day: 8</li>
                                        <li>Available Hours: 25 × 8 = 200 hours</li>
                                        <li>Available Units: 200 × 100 = 20,000 units</li>
                                        <li>Unit Cost: 20,000 / 20,000 = ₹1 per unit</li>
                                    </ul>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

