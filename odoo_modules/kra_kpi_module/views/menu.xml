<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu: Visible to developers and admins; client portal users do NOT see this.
         The action MATTERS: without one, Odoo promotes the first visible child's
         action to be the app's (web/models/ir_ui_menu.py walks children[0]), which
         made the landing page role-dependent — most users opened straight onto
         "Task Related Documents". Pointing the root at the welcome screen stops
         that promotion for every role. -->
    <menuitem id="menu_kra_root"
              name="KRA / KPI"
              sequence="10"
              action="kra_kpi_module.action_kra_welcome"
              groups="kra_kpi_module.group_kra_developer"/>

    <!-- ============================================================
         MENU SECTIONS
         The root carried 16 flat items. Odoo renders a menu that has
         children as a titled section in the app dropdown, so grouping
         them is a parenting change rather than new UI.

         Deliberately NO groups= on these headings. Every child keeps
         its own, and Odoo hides a heading whose children are all
         invisible to you. Putting groups here is how a regroup like
         this goes wrong: either a section disappears for someone who
         should see part of it, or it appears for someone who should
         see none of it.
         ============================================================ -->
    <menuitem id="menu_grp_my_work"  name="My Work"  parent="menu_kra_root" sequence="5"/>
    <menuitem id="menu_grp_tracking" name="Tracking" parent="menu_kra_root" sequence="10"/>
    <menuitem id="menu_grp_clients"  name="Clients"  parent="menu_kra_root" sequence="15"/>
    <menuitem id="menu_grp_uploads"  name="Uploads"  parent="menu_kra_root" sequence="20"/>
    <menuitem id="menu_grp_setup"    name="Setup"    parent="menu_kra_root" sequence="25"/>

    <!-- KRA/KPI Master: Only Managers and Admin -->
    <menuitem id="menu_kra_master_screen"
              parent="menu_grp_setup"
              name="KRA / KPI Master"
              action="kra_kpi_module.action_kra_dashboard"
              sequence="10"
              groups="kra_kpi_module.group_kra_manager,base.group_system"/>
    
    <!-- KPI Configuration: Only Managers and Admin -->
    <menuitem id="menu_kpi_config_screens"
              name="KPI Configuration"
              parent="menu_grp_setup"
              sequence="20"
              action="action_kpi_config_screen"
              groups="kra_kpi_module.group_kra_manager,base.group_system"/>
    
    <!-- KPI Actions: Developers + admins. Clients explicitly excluded.
         Opens the board directly. This used to point at a PIN gate that made the
         developer generate a code on their phone before they could see the
         board; the workday now starts from the board's own Start Workday
         button, which already enforces one start + one end per day. -->
    <!-- Sequence 7 puts this immediately above Live Tracking (8), the screen an
         admin flips to and from most often. Note the two carry different groups
         - Live Tracking is admin/owner/system - so they only read as adjacent
         for someone holding both; a pure developer simply gets KPI Actions at
         the top of their menu, which is where they want it anyway. -->
    <menuitem id="menu_kpi_action_screen"
              parent="menu_grp_my_work"
              name="KPI Actions"
              action="kra_kpi_module.action_kpi_action_screen"
              sequence="10"
              groups="kra_kpi_module.group_kra_developer"/>

    <!-- Task Related Documents: Developers + admins. -->
    <menuitem id="menu_task_documents"
              parent="menu_grp_my_work"
              name="Task Related Documents"
              action="kra_kpi_module.action_task_documents"
              sequence="40"
              groups="kra_kpi_module.group_kra_developer"/>

    <!-- WhatsApp Connect: shortcut to the WhatsApp Sessions form so
         coordinators / owners can reconnect without hunting through the
         WhatsApp and Email app menu.  Reuses the action defined by the
         whatsapp_neonize addon. -->
    <menuitem id="menu_kpi_whatsapp_connect"
              parent="menu_grp_setup"
              name="WhatsApp Connect"
              action="whatsapp_neonize.action_whatsapp_session"
              sequence="30"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- WhatsApp Groups -> Client. One group belongs to one client; that
         client's children are its sub-clients. Rows register themselves when
         somebody first posts in a group this number is a member of, so this
         screen is normally about ASSIGNING a client, not creating rows. -->
    <menuitem id="menu_kpi_wa_groups"
              parent="menu_grp_setup"
              name="WhatsApp Groups"
              action="action_kpi_wa_group"
              sequence="31"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- Servers offered by the WhatsApp "New Database" menu. -->
    <menuitem id="menu_kpi_servers"
              parent="menu_grp_setup"
              name="Servers"
              action="action_kpi_server"
              sequence="32"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- The databases each client has. This is what the WhatsApp "Which
         database?" menu reads, so a client with nothing listed here is only
         ever offered "Common". Fetched rows start with no client and are
         offered to nobody until one is assigned. -->
    <menuitem id="menu_kpi_client_dbs"
              parent="menu_grp_setup"
              name="Databases"
              action="action_kpi_client_db"
              sequence="35"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- Optional. A term only applies to a database whose Track term box is
         ticked, and that is off by default. -->
    <menuitem id="menu_kpi_db_terms"
              parent="menu_grp_setup"
              name="Database Terms"
              action="action_kpi_db_term"
              sequence="36"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- Reasons the CLIENT picks when asking for a database to be switched
         off. Shown in a WhatsApp poll, so the wording is read by them. -->
    <menuitem id="menu_kpi_db_disconnect_reasons"
              parent="menu_grp_setup"
              name="Disconnect Reasons"
              action="action_kpi_db_disconnect_reason"
              sequence="37"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- The operational view: what is live, for whom, on what terms, and
         what has been asked to be switched off. Under Clients rather than
         Setup because it is read daily, not configured once. -->
    <menuitem id="menu_kpi_live_dbs"
              parent="menu_grp_clients"
              name="Live Databases"
              action="action_kpi_live_db"
              sequence="20"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- Meetings a client asked for on WhatsApp. They arrive with NOBODY
         assigned: confirming one means setting the time, saying who joins,
         and pressing the button that sends the link. -->
    <menuitem id="menu_kpi_meetings"
              parent="menu_grp_my_work"
              name="Meetings"
              action="action_kpi_meeting"
              sequence="20"
              groups="kra_kpi_module.group_kra_developer"/>

    <!-- Packages offered by the WhatsApp "New Database" menu. -->
    <menuitem id="menu_kpi_install_presets"
              parent="menu_grp_setup"
              name="Install Packages"
              action="action_kpi_install_preset"
              sequence="34"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- Reasons the admin can pick when declining or re-typing a submission. -->
    <menuitem id="menu_kpi_decline_reasons"
              parent="menu_grp_setup"
              name="Decline Reasons"
              action="action_kpi_decline_reason"
              sequence="33"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>
    
    <!-- ✅ Settings Menu. Header visible to manager/admin/owner/system so the
         operational items reparented here (Backup, Snapshots, Login Management,
         Data Cleanup, Reassignment History, Client Pre-Approvals) stay reachable.
         Each child keeps its OWN groups — widening the header grants no new access. -->
    <menuitem id="menu_kpi_settings"
              name="Settings"
              parent="menu_kra_root"
              sequence="100"
              groups="kra_kpi_module.group_kra_manager,kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- ✅ FIXED: Data Cleanup now opens AUTH popup first.
         Defined AFTER menu_kpi_settings so its parent ref resolves (same-file order). -->
    <menuitem id="menu_kpi_cleanup"
              name="Data Cleanup"
              parent="menu_kpi_settings"
              action="action_kpi_cleanup_auth"
              sequence="76"
              groups="base.group_system"/>

</odoo>