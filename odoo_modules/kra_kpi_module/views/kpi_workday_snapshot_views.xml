<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The frozen End-Workday summary images: date > developer > image. -->
    <record id="action_kpi_workday_snapshot" model="ir.actions.client">
        <field name="name">Workday Snapshots</field>
        <field name="tag">kpi_workday_snapshot</field>
    </record>

    <!-- Reparented under Settings (with the other operational/admin tools).
         Gated with the house triple used by every recent admin screen
         (Client Pre-Approvals, Login Management, Configuration). NOT group_kra_manager —
         that one is deprecated (see security/kra_kpi_groups.xml). -->
    <menuitem id="menu_kpi_workday_snapshot"
              name="Workday Snapshots"
              parent="kra_kpi_module.menu_kpi_settings"
              action="kra_kpi_module.action_kpi_workday_snapshot"
              sequence="72"
              groups="kra_kpi_module.group_kra_admin,kra_kpi_module.group_kra_owner,base.group_system"/>

    <!-- The developer's OWN snapshots. Same screen, but backed by
         /kpi_workday_snapshot/my_list + my_image_b64, which are hard-scoped to
         request.env.user. Sits beside My Workday under the main root rather than
         in Settings: this is a developer's own record, not an admin tool. -->
    <record id="action_kpi_my_workday_snapshot" model="ir.actions.client">
        <field name="name">My Workday Snapshots</field>
        <field name="tag">kpi_my_workday_snapshot</field>
    </record>

    <menuitem id="menu_kpi_my_workday_snapshot"
              name="My Workday Snapshots"
              parent="menu_grp_my_work"
              action="kra_kpi_module.action_kpi_my_workday_snapshot"
              sequence="30"
              groups="kra_kpi_module.group_kra_developer"/>

    <!-- My Workday — the developer's own last N days, from /kpi_reports/my_workday. -->
    <record id="action_kpi_my_workday" model="ir.actions.client">
        <field name="name">My Workday</field>
        <field name="tag">kpi_my_workday</field>
    </record>

    <menuitem id="menu_kpi_my_workday"
              name="My Workday"
              parent="menu_grp_my_work"
              action="kra_kpi_module.action_kpi_my_workday"
              sequence="20"
              groups="kra_kpi_module.group_kra_developer"/>

</odoo>
